# ==========================================
# SALONX (THE SELLO) ENVIRONMENT VARIABLES
# ==========================================

# Supabase URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe for client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (kept secret on the server for admin operations)
# Optional: if not provided, the server falls back to anon key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Base API URL (optional for custom deployment origins)
NEXT_PUBLIC_API_URL=
